# Copy this file to .env and fill in your values: cp .env.example .env
# .env is gitignored — never commit real API keys.

# Any OpenAI-compatible provider works (ollama, lmstudio, openrouter, gemini, deepseek, anthropic, openai)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Reasoning/"thinking" on or off (default false: faster and far fewer tokens)
LLM_THINKING=false

# Default for vacancy extraction: Gemini (chosen by the eval in milestone 1.5).
# ${GEMINI_API_KEY} reuses the key below, so it is stored only once.
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=${GEMINI_API_KEY}
# LLM_MODEL=gemini-3.8-flash
# LLM_THINKING=false

# Local fallback: Ollama on Windows, reached from WSL
# Ollama ignores the key, but the OpenAI client requires a non-empty value.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# LLM_THINKING=false

# Embeddings (semantic search, CV matching). One model for vacancies, CVs and
# queries: they have to share a vector space to be comparable at all.
#
# Default since milestone 3.1: gemini-embedding-2, which won the retrieval eval on
# the 202 real vacancies (88% hit@1 on holdout against 75% for the local model).
# This sends vacancy text -- and later your CV -- to Google. That is allowed by
# the policy in CLAUDE.md of 2026-09-21; the local block below is the way out.
EMBED_PROVIDER=gemini
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBED_API_KEY=${GEMINI_API_KEY}
EMBED_MODEL=gemini-embedding-2

# Local alternative: nothing leaves the machine. Costs about 13 points of hit@1.
# EMBED_PROVIDER=ollama
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=qwen3-embedding:0.6b

# Reading a CV (milestone 3.4) and explaining a match (3.6). Its own prefix,
# because where your CV goes is a separate decision from where a public vacancy
# goes. The default is the same model as extraction: CLAUDE.md allows personal
# data on a cloud model since 2026-09-21, and Gemini's paid API does not train on
# it. The local block underneath keeps the CV on this machine; it costs quality,
# which milestone 3.6 measures rather than guesses.
#
# Whatever you choose here, your CV is stripped of e-mail, phone, address,
# postcode, date of birth and links before it is sent, and
# `scripts/read_cv.py --show-sent` prints exactly what would leave the machine.
CV_PROVIDER=gemini
CV_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CV_API_KEY=${GEMINI_API_KEY}
CV_MODEL=gemini-3.8-flash
CV_THINKING=false

# Local alternative: your CV never leaves this machine.
# CV_PROVIDER=ollama
# CV_BASE_URL=http://localhost:11434/v1
# CV_API_KEY=ollama
# CV_MODEL=qwen3:8b
# CV_THINKING=false

# Provider keys, referenced by the eval config (evals/extraction.toml)
GEMINI_API_KEY=
